{
  "name": "maharashtra-skill-intelligence-platform",
  "version": "1.0.0",
  "description": "Maharashtra Skill Intelligence Platform",
  "scripts": {
    "build": "pip3 install --break-system-packages -r backend/requirements.txt || pip3 install -r backend/requirements.txt || pip install -r backend/requirements.txt || true",
    "start": "node server.js",
    "stop": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 3000, 8000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\""
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.13"
  }
}
