# =============================================================================
# Maharashtra Skill Intelligence Platform — Environment Configuration Template
# =============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR REAL VALUES.
# NEVER COMMIT .env TO VERSION CONTROL.

# -----------------------------------------------------------------------------
# APPLICATION SERVER (local Node proxy)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# FASTAPI BACKEND (local dev)
# -----------------------------------------------------------------------------
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# DATABASE CONNECTION
# -----------------------------------------------------------------------------
# Single connection string used by all Python services and ingest.py.
# Local PostgreSQL:
#   DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/maharashtra_skill_intelligence
# Supabase Session Pooler (from Project Settings -> Connect):
#   DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/maharashtra_skill_intelligence

# -----------------------------------------------------------------------------
# GROQ LLM CONFIGURATION (conversational layer — backend only, never frontend)
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------------
# FIREBASE AUTHENTICATION (web client — public keys)
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY_HERE
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX