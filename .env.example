# =============================================================================
# Maharashtra Skill Intelligence Platform — Environment Configuration Template
# =============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR REAL VALUES.
# NEVER COMMIT .env TO VERSION CONTROL.

# -----------------------------------------------------------------------------
# APPLICATION SERVER CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# FASTAPI BACKEND CONFIGURATION
# -----------------------------------------------------------------------------
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_URL=http://127.0.0.1:8000

# Optional: Cloud-hosted FastAPI backend endpoint (e.g. Render, Railway, Fly.io)
SIH_API_BASE_URL=https://your-api-domain.example.com

# -----------------------------------------------------------------------------
# FIREBASE AUTHENTICATION CONFIGURATION (PLACEHOLDER VALUES)
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY_HERE
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# DATABASE SECRETS (IF APPLICABLE)
# -----------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=maharashtra_skills
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
